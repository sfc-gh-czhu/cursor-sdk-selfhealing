# Cursor API key (Dashboard → Integrations or Team → Service accounts)
CURSOR_API_KEY=cursor_...

# GitHub repo the cloud agent clones and opens PRs against
# For demos, point at a fork/clone that includes demo/pipeline-repo SQL
ADE_TARGET_REPO=https://github.com/your-org/your-pipeline-repo
ADE_TARGET_BRANCH=main

# Model id (optional; defaults to composer-2.5)
ADE_MODEL=composer-2.5

# Inline Snowflake MCP (HTTP). Never commit real tokens.
ADE_SNOWFLAKE_MCP_URL=https://your-account.snowflakecomputing.com/api/v2/mcp
ADE_SNOWFLAKE_MCP_TOKEN=your_snowflake_pat_or_bearer_token

# Optional defaults for demos
ADE_DEFAULT_DATABASE=ADE_DEMO
ADE_DEFAULT_SCHEMA=OPS
ADE_DEFAULT_WAREHOUSE=COMPUTE_WH

# Local run store directory (JSONL). Defaults to ./.runs
ADE_RUN_STORE_DIR=.runs

# When set to 1, skip live Cursor/Snowflake calls and use fixture outcome
ADE_DRY_RUN=0
